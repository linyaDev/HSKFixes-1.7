<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>HSKFixes17</AssemblyName>
    <RootNamespace>HSKFixes17</RootNamespace>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <LangVersion>12.0</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Условных папок здесь нет: мод целиком про 1.7, и его About ограничивает версию. -->
    <OutputPath>..\..\Assemblies</OutputPath>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <!-- Тот же снимок API 1.7, что у HSKMultiplayer; Unity API предоставляет UnityStubs. -->
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4995-unstable" />
    <Reference Include="0Harmony">
      <HintPath>$(MSBuildThisFileDirectory)../../../Updated/Harmony/1.7/Assemblies/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
</Project>
